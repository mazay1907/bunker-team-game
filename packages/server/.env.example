# Server configuration (copy to .env and fill in real values)

# Port the server listens on (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=production

# Allowed CORS origin for the client (e.g. https://your-app.up.railway.app)
ALLOWED_ORIGIN=

# n8n "survival prediction" webhook
SURVIVAL_WEBHOOK_URL=
SURVIVAL_WEBHOOK_SECRET=
